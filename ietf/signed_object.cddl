; CC 2.6.1.7 - the signed object. GENERATED by
; tools/build_cc_signed_object.py from
; constitution/signed_object.tsv; do not edit. RFC 8610 CDDL, JSON
; profile (Appendix E).
; Typed from CIRISPersist 32512f52 src/federation/envelope.rs.
; The signing input is JCS(attestation-row.attestation_envelope), RFC
; 8785, and nothing else.

attestation-row = {
  attestation_id: uuid,  ; REQUIRED
  attesting_key_id: key-id,  ; REQUIRED
  attested_key_id: key-id,  ; REQUIRED
  attestation_type: row-type,  ; REQUIRED
  ? weight: number,  ; OPTIONAL; default absent
  asserted_at: rfc3339,  ; REQUIRED
  ? expires_at: rfc3339,  ; OPTIONAL; default absent
  ; OPTIONAL (absent when empty); default absent; array kind: set
  ? subject_key_ids: [* subject-id],
  cohort_scope: cohort-scope,  ; REQUIRED; default federation
  attestation_envelope: envelope,  ; REQUIRED
  original_content_hash: hex64,  ; REQUIRED
  ; OPTIONAL (absent when empty); default absent; array kind:
  ; sequence
  ? additional_scrubs: [* scrub-sig],
  ; OPTIONAL (store-computed; absent on a row as emitted)
  ? persist_row_hash: hex64,
  scrub_signature_classical: base64,  ; REQUIRED
  ? scrub_signature_pqc: base64,  ; REQUIRED at the federation tier
  scrub_key_id: key-id,  ; REQUIRED
  scrub_timestamp: rfc3339,  ; REQUIRED
  ? pqc_completed_at: rfc3339,  ; OPTIONAL
  ; persist-internal members (tier, promoted_at,
  ; withdraws_admission_rule) are not part of this contract
}

; The signed object. Member presence is exactly what the producer
; signed (CC 2.6.1.1):
; an absent optional member is absent, never materialised; unknown
; members are preserved (CC 2.1.1).
envelope = {
  ; REQUIRED; the closed mirror of the seven columns beside the row
  row: row-mirror,
  asserted_at: rfc3339-ms,  ; REQUIRED; default stamped at the mint
  ? expires_at: rfc3339-ms,  ; OPTIONAL; default absent (no expiry)
  dimension: tstr,  ; REQUIRED on every row type
  ; REQUIRED on supersedes, withdraws, recants
  ? references_attestation_id: uuid,
  ; REQUIRED on consent:state:granted and on delegates_to; array
  ; kind: set
  ? scope: tstr / [* tstr],
  ; OPTIONAL (charter); default absent
  ? pre_rotation_commitment: hex64,
  ; REQUIRED on a charter recovery; default absent
  ? recovers: key-id,
  ; REQUIRED on a charter recovery; default absent; array kind: set
  ? successor_keys: [* key-id],
  ? withdrawal_reason: tstr,  ; OPTIONAL on withdraws; default absent
  ; OPTIONAL on consent:state:*; default absent
  ? consent_supersedes: uuid,
  ? delivery_mode: "pull" / "push",  ; OPTIONAL; default pull
  ? deletion_window: tstr,  ; OPTIONAL; default absent
  ? listed: "public",  ; OPTIONAL; default absent (private roster)
  ? media: { * tstr => any },  ; OPTIONAL; default absent
  ; REQUIRED on a widening supersedes, absent otherwise; default
  ; absent
  ? widened_at: rfc3339-ms,
  ? accord_root: key-id,  ; REQUIRED on accord:* rows; default absent
  ; OPTIONAL on trust:charter:v1; default absent (anchor only)
  ? attach_window_secs: uint,
  ; REQUIRED on a witnessed lineage's charter; default absent
  ? witness_cadence_secs: uint,
  ; REQUIRED on a witnessed lineage's charter; default absent (= 0,
  ; witnessed mode off)
  ? witness_quorum: uint,
  ? attached_head_digest: hex64,  ; REQUIRED on trust:accepts:v1
  ; REQUIRED on the accord's charter
  ? recovery_commitments: { * key-id => hex64 },
  ? score: number,  ; REQUIRED on scores
  ? confidence: number,  ; REQUIRED on scores
  ? context: tstr,  ; OPTIONAL; default absent
  ; OPTIONAL (some families require it); default absent; array kind:
  ; sequence
  ? evidence_refs: [* tstr],
  ? valid_until: rfc3339-ms,  ; OPTIONAL; default absent
  ; OPTIONAL; default direct
  ? epistemic_mode: "direct" / "crypto" / "hearsay" / "derivative"
    / "appeal",
  ; OPTIONAL; default external
  ? witness_relation: "self" / "external" / "derived",
  ; OPTIONAL; default absent (per-cell default)
  ? oversight_mode: "HITL" / "HOTL" / "HOOTL",
  ; OPTIONAL; default absent (read as occurrence-0)
  ? occurrence_id: tstr,
  ? occurrence_count: uint,  ; OPTIONAL; default absent (read as 1)
  ; OPTIONAL; default absent (read as primary)
  ? occurrence_role: "primary" / "shared" / "replica",
  ; OPTIONAL; default reputational
  ? stake: "free" / "reputational" / "capital" / "cryptoeconomic",
  ; REQUIRED iff cohort_scope is community or affiliations
  ? community_id: key-id,
  ? family_id: key-id,  ; REQUIRED iff cohort_scope is family
  ? session_id: tstr,  ; REQUIRED on session:*
  ? claimed_at: rfc3339-ms,  ; REQUIRED on session:*
  ? custody_state: "here" / "none",  ; REQUIRED on custody:ack
  ; REQUIRED on membership:proposal
  ? group_kind: "family" / "community",
  ; OPTIONAL on membership:proposal, restated on
  ; membership:acceptance; default absent
  ? role: tstr,
  ; REQUIRED on membership:acceptance and membership:decline
  ? proposal_hash: hex64,
  ; OPTIONAL on moderation:*; default absent
  ? subject_sha256_ed25519_raw: hex64,
  ; OPTIONAL on the accord's charter; default 86400 (a constant of
  ; this document)
  ? halt_fuse_secs: uint,
  ; REQUIRED on a witnessed lineage's charter; array kind: set
  ? witnesses: [* key-record],
  ; OPTIONAL; default from_join
  ? history_on_join: "full" / "from_join",
  ; OPTIONAL on supersedes; default absent
  ? supersession_reason: tstr,
  ; OPTIONAL on supersedes; a widening lists cohort_scope; default
  ; absent; array kind: set
  ? differs_in: [* tstr],
  ? recantation_reason: tstr,  ; OPTIONAL on recants; default absent
  ? what_was_false: tstr,  ; OPTIONAL on recants; default absent
  ; OPTIONAL on delegates_to; default absent
  ? delegation_purpose: tstr,
  ; OPTIONAL on delegates_to; default the edge's asserted_at
  ? delegation_valid_from: rfc3339-ms,
  ; REQUIRED on a termed delegates_to (CC 2.4.1), otherwise OPTIONAL;
  ; default absent (open-ended)
  ? delegation_valid_until: rfc3339-ms,
  ; family payload members (CC 3.3) and anything a consumer has not
  ; learned yet
  * tstr => any,
}

; Closed: exactly these seven members (CIRISPersist#643).
; deny_unknown_fields.
row-mirror = {
  attestation_id: uuid,  ; REQUIRED
  attesting_key_id: key-id,  ; REQUIRED
  attestation_type: row-type,  ; REQUIRED
  attested_key_id: key-id,  ; REQUIRED; default the attester
  ; REQUIRED (may be empty); default []; array kind: set
  subject_key_ids: [* subject-id],
  cohort_scope: cohort-scope,  ; REQUIRED; default federation
  ? weight: number,  ; OPTIONAL; default absent
}

scrub-sig = {
  scrub_key_id: key-id,  ; REQUIRED
  scrub_signature_classical: base64,  ; REQUIRED
  ? scrub_signature_pqc: base64,  ; REQUIRED at the federation tier
  ? cosigned_at: rfc3339-ms,  ; OPTIONAL; default absent
}

key-record = {
  key_id: key-id,  ; REQUIRED
  pubkey_ed25519_base64: base64,  ; REQUIRED
  ? pubkey_ml_dsa_65_base64: base64,  ; REQUIRED for algorithm hybrid
  algorithm: tstr,  ; REQUIRED
  identity_type: tstr,  ; REQUIRED
  identity_ref: tstr,  ; REQUIRED
  valid_from: rfc3339,  ; REQUIRED
  ? valid_until: rfc3339,  ; OPTIONAL; default absent
  registration_envelope: { * tstr => any },  ; REQUIRED
  original_content_hash: hex64,  ; REQUIRED
  scrub_signature_classical: base64,  ; REQUIRED
  ? scrub_signature_pqc: base64,  ; REQUIRED once hybrid-complete
  scrub_key_id: key-id,  ; REQUIRED
  scrub_timestamp: rfc3339,  ; REQUIRED
  ? pqc_completed_at: rfc3339,  ; OPTIONAL
  persist_row_hash: hex64,  ; REQUIRED
  ? roles: [* tstr],  ; OPTIONAL; default []; array kind: set
  ; OPTIONAL; default absent
  ? attestation_evidence: { * tstr => any },
  ; OPTIONAL (absent when empty); default absent; array kind:
  ; sequence
  ? additional_scrubs: [* scrub-sig],
}

row-type = "scores" / "delegates_to" / "supersedes" / "withdraws"
  / "recants"
cohort-scope = "self" / "family" / "community" / "affiliations"
  / "species" / "biosphere" / "federation"
uuid = tstr .regexp "[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}"
; <label>-<fingerprint>, CC 2.6.8; a legacy 64-hex id is also a key-
; id
key-id = tstr .regexp "[a-z0-9-]+"
; CC 2.3.2.1, tag required
canonical-id = tstr .regexp "canonical:[a-z0-9-]+:[0-9a-f]+"
subject-id = key-id / canonical-id
hex64 = tstr .regexp "[0-9a-f]{64}"  ; CC 2.6.3
; RFC 4648 section 4, padded, no whitespace
base64 = tstr .regexp "[A-Za-z0-9+/]+={0,2}"
; CC 2.6.2
rfc3339-ms = tstr .regexp
  "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z"
; a column rendered by the store; the signed twin inside the envelope
; is rfc3339-ms
rfc3339 = tstr

