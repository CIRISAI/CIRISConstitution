; CC 2.6.1 — the signed object: deterministically encoded CBOR signed with COSE, aligned with
; SCITT (RFC 9943). The normative schema of this edition; hand-written. RFC 8610 CDDL over CBOR
; with CBOR Common Deterministic Encoding (draft-ietf-cbor-cde-13, updating RFC 8949). The members
; table of CC 2.6.1 is generated from constitution/signed_object_v2.tsv, and
; tools/build_cc_signed_object_v2.py checks that the table and this file name the same members.
; The earlier JSON object is CC 8.11. The known-answer vectors are the verifier's; this file mints none.
; Every constant the text of CC 2.6 fixes is pinned here, so a validator admits one encoding only.

; Every top-level rule, so a generator exercises them all.
ceg-anything = ceg-statement / ceg-object-statement / second-consent / row-id-input / row-id
             / statement-id-input / statement-id / object-id-input / ceg-key / key-record-members
             / revocation-snapshot / ceg-genesis-bundle / cutover-proof / seat-commitment-input
             / hpke-info / ceg-typ

; A signed statement is one COSE_Sign1 (RFC 9052 §4.2), as RFC 9943 §6 requires: ONE signer.
; A counted row is N statements over one payload, one per voice, found by the row id (below).
; Each voice signs the whole payload, and so the `refs.head` the row is counted over.
; external_aad is the empty bstr for every statement.
ceg-statement = #6.18(COSE_Sign1)

COSE_Sign1 = [
  protected: bstr .cbor statement-protected,   ; in the deterministic encoding, exactly these members: one statement id
  unprotected: unprotected-header,
  payload: bstr .cbor attestation-envelope,    ; never nil: a detached payload is refused
  signature: composite-signature,
]

unprotected-header = {
  ? 17: [+ bstr .cbor sd-disclosure],       ; sd_claims (SD-CWT): blinded members as PRESENTED beside the statement to one who may
                                            ; see them; a disclosure set is held and travels as bytes under the object's consent edge
  * int => any,                             ; a receipt (RFC 9942) may be added by a holder, never signed and never read by a rule
}

; The composite ML-DSA-65-Ed25519 signature of draft-ietf-jose-pq-composite-sigs-06 (over
; draft-ietf-lamps-pq-composite-sigs-19): the ML-DSA-65 signature (3309 bytes) then the Ed25519
; signature (64 bytes). Both sign M' = "CompositeAlgorithmSignatures2025" || "COMPSIG-MLDSA65-Ed25519-SHA512"
; || 0x00 || SHA-512(M), ML-DSA-65 with the label as its context; the application context is empty.
composite-signature = bstr .size 3373

statement-protected = {
  1: composite-alg,                ; alg: the composite ML-DSA-65-Ed25519; private-use until IANA assigns, the construction exactly the draft's
  3: row-cty,                      ; cty: the constant, with no parameters
  4: kid,                          ; kid: the RFC 9679 thumbprint of the signer's AKP composite key (below)
  15: cwt-claims,                  ; RFC 9597: iss and sub as RFC 9943 requires
  16: "ceg-row/2",                 ; typ (RFC 9596): a row's typ is fixed
  -70001: row-type,                ; the row's type, one of the five; the row id reads it
  -70002: family-id,               ; the row's family id, never a leaf; the row id reads it
}

composite-alg = -70100
kid = bstr .size 32                ; the RFC 9679 SHA-256 thumbprint

; cty is one constant with no parameters; a verifier refuses any other. The type and the family
; ride their own labels, -70001 and -70002, required on a row and refused on any other object.
; `family` is a family id, never a leaf: the registry prefix with each {name} written .name and
; each * written . (so `evidence:.suite:.kind:.cell:.prefix`, `accord:.`).
row-cty = "application/vnd.ciris.row+cbor"
row-type = "scores" / "delegates_to" / "supersedes" / "withdraws" / "recants"
family-id = tstr .regexp "[a-z0-9_.][a-z0-9_.-]*(:[a-z0-9_.][a-z0-9_.-]*)*"

cwt-claims = {
  1: identity-ref,                 ; iss: the signer's stable identity reference (its genesis key's thumbprint URI), never the rotating kid;
                                   ; under a room key, iss is the room key's own identity reference, never its person's genesis key
  2: tstr,                         ; sub: what the row is about; a key subject is an identity-ref
  6: uint,                         ; iat: floor(asserted_at / 1000), seconds, derived; a verifier refuses disagreement
  ? 5: uint,                       ; nbf: floor(valid_from / 1000) where the row has one
  ? 4: uint,                       ; exp: floor(valid_until / 1000) where the row has one
  -70003: 2,                       ; edition: the constant 2
}

; One spelling for every identity reference: iss, author, a key subject in sub or subject_key_ids,
; and every role party. The COSE Key Thumbprint URI of RFC 9679 §5.7 with the hash name sha-256 and
; the 32-byte thumbprint in unpadded base64url (43 characters, the last carrying zero trailing bits).
identity-ref = tstr .regexp "urn:ietf:params:oauth:ckt:sha-256:[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]"

; No float, no null, no undefined, no tag anywhere a family member can reach.
; The one exception is SD-CWT's redaction: simple(59) as a map key and tag 60 for an array element.
ceg-value = int / tstr / bstr / bool / [* (ceg-value / redacted-element)]
          / { ? redacted_claim_keys => [+ bstr .size 32], * (tstr / int) => ceg-value }
redacted_claim_keys = #7.59
redacted-element = #6.60(bstr .size 32)

; The payload: the members a family names, every text and byte member bounded, no free text
; outside body.note, absent never null. A member that names a row stands in `refs` and nowhere else.
attestation-envelope = {
  ? "author": identity-ref,        ; the iss of the author: present iff the family is authored, absent iff counted (a column of the family model)
  ? "refs": refs,                  ; EVERY row this row names, by row-ref
  ? "dimension": tstr,             ; the full scored dimension (leaf and :vN); it resolves to cty's family, refused otherwise
  ? "evidence_refs": [+ hash-digest],   ; the blobs the row cites, by content hash: a sequence, bytes never hex
  ? "carried": hash-digest,        ; on an acknowledgement the ceremony names: the RFC 9162 root over the earlier-form names it carries
  ? "seat_commitment": hash-digest,; on a seat row of a private room: the commitment the binding opens (seat-commitment-input)
  ? "score": fixed6-score,         ; integers, never floats (see fixed6)
  ? "confidence": fixed6-unit,
  ? "weight": fixed6-weight,
  ? "passed": count32,             ; safety-battery interpret rows: passed <= total, both present or both absent, with
  ? "total": 1..4294967295,        ; score = round(10^6 * (2*passed - total) / total), ties away from zero, checked by exact equality
  "asserted_at": ms-time,
  ? "valid_from": ms-time,
  ? "valid_until": ms-time,
  ? "expires_at": ms-time,
  ? "reason": uint,                ; a code from a closed registry, 0 = unspecified
  ? "salt": bstr .size 16,         ; required where the content is low-entropy (a ballot, a census cell); bound by every signer
  ? redacted_claim_keys => [+ bstr .size 32],   ; SD-CWT simple(59): digests of the blinded members, in mint order (a sequence)
  ? "body": body,
  * tstr => ceg-value,             ; the members a family names, under the logical names of the CC 2.6.1 table
}

body = { ? "note": tstr .size (0..2048), ? redacted_claim_keys => [+ bstr .size 32], * tstr => ceg-value }
count32 = 0..4294967295

; Erasability: the selective disclosure of draft-ietf-spice-sd-cwt-09. A blinded map member is absent
; from its map, and the digest of its disclosure stands in that map's simple(59) array; a blinded array
; element is tag 60 over that digest. The digest is SHA-256 (no sd_alg) over the disclosure's bytes as
; sd_claims carries them. A family whose erasure_route is dsar or purge mints every free-text member and
; every member another party authored blind, body.note first; the members are the family model's
; `blind` column, and no fold, verdict or admission reads one.
sd-disclosure = salted-claim / salted-element
salted-claim = [salt: bstr .size 16, value: ceg-value, key: tstr]
salted-element = [salt: bstr .size 16, value: ceg-value]
ms-time = uint                     ; POSIX milliseconds, no tag, never a float

; Integers at one fixed scale: fixed6 is the value times 10^6. Folds sum in checked i64 and refuse on
; overflow, never wrap. A derived value is rounded ties away from zero, in integers, unless its own
; rule states otherwise, and checked by exact equality. The default ranges are these; weight is
; [0, 10^6] by rule, and a family that states a wider range for it states it in its own rule.
fixed6 = -9223372036854775808..9223372036854775807
fixed6-score = -1000000..1000000
fixed6-unit = 0..1000000
fixed6-weight = fixed6

; The row id: the digest a row is NAMED by. One per row, the same for every voice of a counted row,
; unchanged when a voice, a receipt or a disclosure is added. Signatures, kid, alg, receipts and
; disclosures are outside it. `type` and `family` are the header's -70001 and -70002; `sub` is the CWT sub; `author` is
; the payload's "author" for an authored family and null for a counted one; `payload` is the payload
; bstr as signed, entered as a byte string, never as the decoded map. A payload whose bytes are not the
; deterministic re-encoding of the value they decode to is refused, so one row has one payload and one id.
row-id-input = ["CEG-row/2", type: row-type, family: family-id, sub: tstr, author: identity-ref / null,
                payload: bstr .cbor attestation-envelope]
row-id = hash-digest

hash-digest = [ alg: -16, digest: bstr .size 32 ]   ; SHA-256 only in this edition: one name per row

; A reference to a signed object of either form. Edition 2: the row id above, or the object id
; (below) of a signed object that is not a row. The earlier form (CC 8.11): the earlier-form name,
; SHA-256 of the message of the object's Ed25519 half (the canonical bytes both halves bind, never
; those bytes followed by the Ed25519 signature), by a per-family rule; for a genesis bundle,
; SHA-256 of its 32-byte authorization_digest. Never an attestation_id.
row-ref = [ edition: 1 / 2, id: hash-digest ]
row-ref-set = [+ row-ref]          ; a set: sorted by the bytewise order of each element's encoding, no duplicate

; Every member that names a row. A verifier gathers the named set from `refs` alone, without knowing
; the family. SET RULE: every array inside `refs` is a set: its elements sorted by the bytewise order
; of each element's deterministic encoding, no duplicate, refused otherwise. An empty `refs` is
; refused: absence is its one encoding.
refs = refs-members .and nonempty-map
refs-members = {
  ? "head": row-ref,               ; the roster head this row is counted over, or a version extends
  ? "further_heads": row-ref-set,  ; further tips named beside `head`
  ? "prev": row-ref,               ; the predecessor in a signer's own series
  ? "answers": row-ref,            ; the proposal voted on or accepted, the window opened, the row replied to
  ? "target": row-ref,             ; the row superseded, withdrawn, recanted, cut or removed
  ? "trusted_through": row-ref-set,; on a key revocation: the last rows of the revoked key held good
  ? "also": { + also-role => row-ref-set },   ; any other named row, under a role of the closed registry
}
; The also roles, closed: "ack" names an acknowledgement (a revocation snapshot's, a genesis bundle's);
; "cites" names the row a row cites, as a build attestation names its manifest contribution. Any other
; role is a later registration.
also-role = "ack" / "cites"
nonempty-map = { + any => any }

; The statement id (RFC 9943 statement identity): SHA-256 over the deterministic encoding of this
; labelled structure. It names a statement, one voice; the row id names the row.
statement-id-input = ["CEG-statement-id/2", protected: bstr, payload: bstr]
statement-id = hash-digest

; The second consent. A statement over an authored payload whose iss is not the payload's "author"
; is accepted only in a role the family names (delegate, bound node, ...), and only when its iss is
; the party that role names in the payload, or the CWT sub where the role is the attested key; any
; other iss is Invalid. The second consent of a scoped delegates_to is such a statement, by the
; delegate (the sub), over the same payload bytes, and so has the same row id; a scoped delegation
; of this form seats only with it.
second-consent = ceg-statement

; Keys: one AKP COSE_Key (RFC 9964 kty 7) whose alg is the composite and whose pub is the composite
; public key encoding of the pinned draft revision: the ML-DSA-65 public key (1952 bytes) then the
; Ed25519 public key (32 bytes). The kid is its RFC 9679 thumbprint, computed under the private-use
; alg and fixed for the key's life. A composite key never verifies on one half.
ceg-key = { 1: 7, 3: composite-alg, -1: bstr .size 1984 }

; A key record is a ROW on family key:record (CC 2.4.1.1 renews it by supersedes and rotates it by
; naming it), so these are members of its attestation-envelope, not a separate typ. identity_type is
; a SET of roles (CC 4.5.8). The end rule reads "contains", in prose (CC 2.4.1.1): a set mixing
; user or accord_holder with node or agent is refused; a record whose set contains user or
; accord_holder carries no valid_until; one whose set contains node or agent carries one, unless it
; is a room key of a private room; a role outside both groups takes no end rule of its own; asserted_at <= valid_until <= asserted_at +
; key_record_max_secs * 1000; refused key_record_out_of_window otherwise.
key-record-members = {
  "key": ceg-key,
  "identity_type": [+ tstr],       ; a set
  "asserted_at": ms-time,
  ? "valid_until": ms-time,
  * tstr => ceg-value,
}

; The signed objects that are not rows, each its own typ, closed: a verifier refuses any other typ.
; No cty; the payload is .cbor the rule its typ names, in the deterministic encoding.
ceg-object-statement = #6.18([
  protected: bstr .cbor object-protected,
  unprotected: unprotected-header,
  payload: bstr,
  signature: composite-signature,
])
object-protected = {
  1: composite-alg,
  4: kid,
  15: object-claims,
  16: object-typ,
}
object-claims = {
  1: identity-ref,                 ; iss
  ? 6: uint,                       ; iat where the object states an instant; a revocation snapshot carries none
  -70003: 2,
}
object-typ = "ceg-genesis-bundle/2" / "ceg-revocation-snapshot/2" / "ceg-boot-manifest/2"
; The payload rule of ceg-boot-manifest/2 waits on its owner's submission; no rule here stands in for it.
ceg-typ = "ceg-row/2" / object-typ

; A signed object that is not a row is named like a row, so prev and every row-ref to it have a
; defined id: SHA-256 over the deterministic encoding of this array, written as a hash-digest. The
; domain label keeps it apart from a row id; like the row id it is the same for every voice of a
; counted object (a genesis bundle). `author` is the payload's "author", or null where it has none.
object-id-input = ["CEG-object/2", typ: object-typ, author: identity-ref / null, payload: bstr]

; A revocation snapshot (typ "ceg-revocation-snapshot/2"): a signer's own record of the revocations
; whose past it holds. A set with no winner across signers. `seq` orders one signer's own snapshots:
; strictly greater than prev's, refused otherwise; two snapshots of one signer with one seq and
; different content are contested, and neither counts. refs carries prev (absent on the first) and,
; under also "ack", the signer's acknowledgement of the head of the revocation scope. Its named set
; is refs with each revoked entry's revocation and trusted_through.
revocation-snapshot = {
  "author": identity-ref,          ; the signer, so the object id, prev and seq are one signer's
  "refs": refs,
  "seq": uint,
  "revoked": [* revoked-entry],    ; a set
}
revoked-entry = [key: kid, revocation: row-ref, trusted_through: [* row-ref]]   ; a tuple; its trusted_through a set

; The genesis bundle (typ "ceg-genesis-bundle/2"), the GenesisBundle of CC 5.3.4. The first of this
; form is the ceremony row of CC 2.6.1.12, a signed object that is not a row. refs.prev names its
; predecessor (for the first, the earlier-form bundle, by SHA-256 of its authorization_digest);
; refs.also "ack" names the acknowledgement of each scope it carries over. `version` is a sequence
; from 1, never ranked: prev's version + 1 where prev is of this form, a consistency check only.
ceg-genesis-bundle = {
  ? "refs": refs,
  "version": uint,
  * tstr => ceg-value,
}

; The cutover proof: an earlier-form object is accepted iff it lies in the past of the edition's
; ceremony row, by a chain of names; no instant and no log position is compared. links[0] is the
; ceremony's statement bytes, named `ceremony`; each later bstr link is a statement of this form
; named in the refs of the link before it; the last link may be the Ed25519-half message of an
; earlier-form object, or an inclusion in a carried root. A sequence, ceremony first.
cutover-proof = [ ceremony: row-ref, links: [+ link] ]
link = bstr / inclusion
; An RFC 9162 inclusion proof of a leaf CDE(row-ref) in the `carried` root of the link before it.
; The leaves are the earlier-form names carried, sorted by their encoding and without duplicate:
; leaf_index is a position in that set, never a log position or an instant.
inclusion = [ "carried", tree_size: uint, leaf_index: uint, path: [* bstr .size 32] ]

; Room keys. The seat commitment of a private room: SHA-256 over the deterministic encoding of this
; array, carried as "seat_commitment" on the seat row and opened by the binding. `room` is the room's
; id; the member that carries it waits on its owner's submission. `nonce` is 32 fresh random bytes. The binding key and the content-KEM keys
; of one identity are distinct bytes, refused at admission otherwise.
seat-commitment-input = ["CEG-seat/2", room: tstr, room_key: kid, person: identity-ref, nonce: bstr .size 32]
; The HPKE info strings of a binding and of an invitation. The KEM key, the binding's two
; encapsulations and the occurrence keys take their bytes from the X-Wing HPKE suite and are fixed
; with that suite's known-answer vectors, not in this file; so does the binding seed's derivation label.
hpke-info = "CEG-binding/2" / "CEG-invitation/2"

; Verification has three answers, returned by a verifier and never on the wire: Valid; Invalid(reason);
; Waiting{missing key refs}. Invalid under a held key is final. A structural fault is Invalid whatever
; keys are held. A statement whose key record is Waiting is Waiting, naming the deepest missing key; a
; key record Invalid makes the statement Invalid. An earlier-form hybrid key held in part is Waiting on
; the missing half. Waiting is never counted.

; Receipts over the provenance log and each stream's log are COSE Receipts (RFC 9942) with
; vds = 1 (RFC9162_SHA256); each witness issues its own receipt over the same root, with its
; instant in the protected header; a receipt is issued per batch of a stream, never per chunk.
