; CC 2.6.1.4: the payload rules of the families it names, over the rules of manifests/signed_object_v2.cddl and read
; with it. GENERATED by tools/build_cc_signed_object_v2.py from constitution/signed_object_v2.tsv; do not edit.
; The two files are one schema; signed_object_v2.cddl stays as the Internet-Draft's -01 carries it.
;
; Each rule is the payload of an ordinary row, so its members are members of the row's attestation-envelope, as a
; key record's are. Each carries the members its family names one to one and embeds no signed object. What a
; family's record carried as a co-signature is a further statement over the same payload, a counted voice
; (CC 2.6.1.9), never a member. A payload that breaks its family's rule is refused edition2_payload_invalid
; (CC 2.6.1.8 step 3). A member required only on one stage, axis or state is optional here and checked in prose.

; group:roster: a counted row, with no author; sub is the group's identity reference.
group-roster = {
  "group_kind": "family" / "community",     ; Which record the version is: a family's or a community's.
  "group": group-ref,                       ; The group's id, equal to the CWT sub. It is derived from the first version (group-id-input), and nobody chooses it.
  "name": tstr,                             ; Human-readable and not unique.
  "version": uint,                          ; The version's place in the lineage's chain; a consistency check, never ranked.
  "members": [* roster-member],             ; The roster at this version: a set.
  "founded_at": ms-time,                    ; POSIX milliseconds.
  ? "nonce": bstr .size 32,                 ; Thirty-two fresh random bytes that the group's id covers. Absent on every later version. (on the first version, and on no other)
  "consensus_protocol": tstr,               ; One of the closed vocabulary of CC 3.3.4.
  ? "consensus_protocol_entrenched": bool,  ; Absent reads false. (where the group entrenches its protocol)
  ? "cohort_subkind": tstr,                 ; The community's subkind: open vocabulary. (on a community's record)
  ? "cohort_subkind_payload": { * tstr => ceg-value }, ; The subkind's members, such as a geographic community's constraint. (where the subkind carries members of its own)
  ? "membership": "private" / "public",     ; Absent reads public. (where a community declares how its roster is seated)
  ? "dissolved_at": ms-time,                ; POSIX milliseconds. (where the group is dissolved)
  ? "policy": { * tstr => ceg-value },      ; The members the record declares at creation beyond those above. (where the record carries the group's policy)
  ? "duty_holders": { + tstr => [+ identity-ref] }, ; A duty name (moderate, or one the record declares in policy.duties) to the set of members who hold it at founding. Each is a listed member who signed the record. On the first version of a community only: later seats move by conferral, withdrawal, resignation and election. (on a community's founding record that names who holds its duties)
  ? "transparency_services": [2* identity-ref], ; The transparency services the room names: a set of at least two identity references, each resolved through its own key record. One of the two members without the other is refused, transparency_members_partial. (where a community names the services its accountable streams register with)
  ? "receipt_quorum": uint .ge 2,           ; How many of the named services must register a head: exactly ⌊n/2⌋+1 of the n named. Any other value is refused, receipt_quorum_mismatch. (where transparency_services is present, and never without it)
  ? "refs": refs,                           ; The predecessor version in refs.head. charter_digest names nothing in this form: no row carries a charter, and a root's charter is its bundle's charter member. (on every version after the first)
  "asserted_at": ms-time,                   ; POSIX milliseconds.
  * tstr => ceg-value,
}

; A member of a roster version: a closed map.
roster-member = {
  "key": identity-ref,                      ; The member's identity, never an occurrence.
  "joined_at": ms-time,                     ; POSIX milliseconds.
  ? "role": tstr,                           ; founder or member; absent, never null. (where the record gives the member a role)
}

; membership:{stage}, the stages widening and removal: counted, with no author; sub is the member.
membership-change = {
  "dimension": tstr,                        ; membership:widening:v1 or membership:removal:v1.
  "group_kind": "family" / "community",     ; Which group the change is to.
  "group": group-ref,                       ; The group's id.
  "member": identity-ref,                   ; The key seated or removed, equal to the CWT sub.
  ? "joined_at": ms-time,                   ; POSIX milliseconds. (on a widening)
  ? "removed_at": ms-time,                  ; POSIX milliseconds. (on a removal)
  "effective_at": ms-time,                  ; The membership-change instant.
  ? "role": tstr,                           ; The same role the acceptance restates. (on a widening that assigns a role)
  ? "witness_set": [* identity-ref],        ; The keys that vouch for the removal, never signatures: a set. (on a removal that names its witnesses)
  ? "valid_until": ms-time,                 ; The seat lapses at this instant. (on a time-boxed guest's widening)
  ? "reason": uint,                         ; A code from the closed registry; free text stands in body.note. (where the change carries a reason)
  "refs": refs,                             ; The roster head the change is counted over in refs.head; on a widening, the joiner's acceptance under the also role cites; a removal MAY carry trusted_through, the member's content rows held good.
  "asserted_at": ms-time,                   ; POSIX milliseconds.
  * tstr => ceg-value,
}

; membership:keeps (CC 3.1.3.2): counted over the roster head refs.head names, with no author; sub is the member whose content it keeps. It cites exactly one end of that member's seat and names 1 to 64 tips.
membership-keeps = {
  "dimension": tstr,                        ; membership:keeps:v1.
  "group_kind": "family" / "community",     ; Which group the room is.
  "group": group-ref,                       ; The group's id.
  "member": identity-ref,                   ; The member whose content the row keeps.
  "refs": refs,                             ; The roster head the row is counted over in refs.head; exactly one end of that member's seat under the also role cites; 1 to 64 tips in trusted_through.
  "asserted_at": ms-time,                   ; POSIX milliseconds.
  * tstr => ceg-value,
}

; membership:acceptance and membership:decline (CC 3.1.3.2, CC 3.1.2.1): authored by the invitee, or on the reply to a grant by the owner of the key the grant names, at federation scope. It names the one row it answers in refs.answers, and no head and no target.
membership-reply = {
  "author": identity-ref,                   ; The invitee; on the reply to a grant, the owner of the key the grant names: a person, never the grantee's own key.
  "dimension": tstr,                        ; membership:acceptance:v1 or membership:decline:v1.
  ? "group_kind": "family" / "community",   ; Which group the proposal is to. (where the reply answers a membership proposal)
  ? "group": group-ref,                     ; The group's id, the group the proposal targets. (where the reply answers a membership proposal)
  ? "role": tstr,                           ; The role the proposal offered. (on an acceptance that restates the role offered)
  "refs": refs,                             ; The one row answered, under answers: the proposal, or the grant. A reply names no head and no target. One that carries proposal_hash is refused.
  "asserted_at": ms-time,                   ; POSIX milliseconds.
  * tstr => ceg-value,
}

; identity:occurrence_revocation: authored by the revoker, or counted over a user self's roster at the head refs names.
occurrence-revocation = {
  ? "author": identity-ref,                 ; The revoker; a user self's revocation is counted over its roster at the head refs names and carries none. (unless the occurrence is of a user self)
  "identity_key_id": identity-ref,          ; The identity whose occurrence is revoked.
  "occurrence_key_id": identity-ref,        ; The occurrence revoked, equal to the CWT sub.
  "revoked_at": ms-time,                    ; POSIX milliseconds.
  "effective_at": ms-time,                  ; POSIX milliseconds; may be later than asserted_at.
  ? "witness_set": [* identity-ref],        ; A set. (where the revocation names its witnesses)
  ? "reason": uint,                         ; A code from the closed registry. (where the revocation carries a reason)
  "refs": eviction-refs,                    ; The self-roster head the revocation is counted over, a merge's further tips, and the proof of its signers.
  "asserted_at": ms-time,                   ; POSIX milliseconds.
  * tstr => ceg-value,
}

; The refs of an eviction (CC 2.6.1.7, CC 3.3.6.4): the head, and the proof of its signers, both required; a closed map.
eviction-refs = {
  "head": row-ref,                          ; The last landed self-roster row the signers stood on.
  ? "further_heads": row-ref-set,           ; The other tips the row merges, as a roster version names them: a set. (where the row merges tips)
  "also": eviction-proof,                   ; The proof of the signers, which travels with the row.
}

; The proof an eviction carries (CC 2.6.1.7): the rows that resolve its voices; a closed map.
eviction-proof = {
  "cites": row-ref-set,                     ; Each voice's key record and, where that key is bound by an occurrence, the occurrence: a set.
}

; revocation:{entity_type}:{reason}: authored by the revoker; sub is the revoked entity.
entity-revocation = {
  "author": identity-ref,                   ; The revoker.
  "dimension": tstr,                        ; revocation:{entity_type}:{reason} with its version; the reason leaf is the coded reason.
  "revoked_at": ms-time,                    ; POSIX milliseconds.
  "effective_at": ms-time,                  ; POSIX milliseconds.
  ? "revoked_after": ms-time,               ; POSIX milliseconds. (where the revocation bounds what it ends)
  ? "refs": refs,                           ; The revoked row under target. (where the revoked entity is a row)
  "asserted_at": ms-time,                   ; POSIX milliseconds.
  * tstr => ceg-value,
}

; takedown_notice:{basis}: authored, or counted where an affiliation has one deciding seat (CC 4.4.3.12), with sub the claimant; or on a steward purge counted over the holders of the bundle in force, with no author and no claimant, sub the lineage's name and the bundle in refs.head.
takedown-notice = {
  ? "author": identity-ref,                 ; A steward purge is counted and carries none, and so is the notice of an affiliation with one deciding seat. (iff the notice is authored)
  "dimension": tstr,                        ; takedown_notice:{basis} with its version.
  "legal_basis": legal-basis,               ; The wire string of the closed set; the basis leaf names the same.
  ? "claimant": identity-ref,               ; The identity issuing the notice. A steward purge is counted and carries none; its sub is the lineage's name. (unless a steward purge)
  "content_sha256": hash-digest,            ; SHA-256 of the content; on a steward purge, the selection digest.
  "content_holders": [* identity-ref],      ; Peers known to hold the bytes: a set.
  "jurisdiction": tstr,                     ; ISO 3166-1 alpha-2 with an optional subdivision.
  "good_faith_statement": tstr,             ; The claimant's good-faith assertion.
  "claim_text": tstr,                       ; The claim made.
  ? "evidence_refs": [+ hash-digest],       ; The backing material by content hash: a sequence. (where the notice cites backing material)
  ? "perceptual_hash": ceg-value,           ; A perceptual hash such as PDQ. (where the notice carries one)
  ? "counter_notice_channel": tstr,         ; A URI where counter-notices may be filed. (where the notice names one)
  ? "selection_counts": { * tstr => ceg-value }, ; The counts of the purge's selection by plane. (on a steward purge that states its counts)
  ? "expires_at": ms-time,                  ; POSIX milliseconds. (where the notice states its own end)
  ? "refs": refs,                           ; The bundle in force, under head: the purge is counted over its holders. (on a steward purge)
  "asserted_at": ms-time,                   ; POSIX milliseconds.
  * tstr => ceg-value,
}
; The legal bases of CC 3.3.2, by their wire strings: a closed set.
legal-basis = "dmca512" / "dsa_article16" / "tvec_terrorist" / "ncmec_csam" / "gifct_cip"
            / "community_standards" / "perceptual_hash_csam" / "osa_illegal_content"
            / "avmsd_age_inappropriate" / "court_order" / "steward_purge"

; custody:{kind}: the device's own report; author, iss and sub are the device.
custody-ack = {
  "author": identity-ref,                   ; The device the report is about, equal to iss and the CWT sub.
  "dimension": tstr,                        ; custody:ack:v1.
  "custody_state": "here" / "none",         ; Whether the device holds the blob.
  "evidence_refs": [hash-digest],           ; The blob's address digest: exactly one.
  ? "size": uint,                           ; The blob's size in bytes. (when custody_state is here)
  "asserted_at": ms-time,                   ; The instant the report is live from, for 72 hours.
  * tstr => ceg-value,
}

; key_grant:{axis}: authored by the sealer; sub is the recipient.
key-grant = {
  "author": identity-ref,                   ; The sealer.
  "dimension": tstr,                        ; key_grant:{axis}:v1.
  "axis": "content" / "epoch" / "stream",   ; The same axis as the leaf.
  "wrap_algorithm": "x25519_mlkem768_aes256_gcm_hkdf_sha256" / "xwing_hpke_aes256_gcm_hkdf_sha256", ; The v2 wire string on a wrap to the content-KEM keys of an occurrence; the X-Wing string on a wrap to a room key, which carries no other.
  "wrapped_dek": bstr,                      ; The wrapped data-encryption key, as bytes. On a wrap to a room key: the X-Wing encapsulation of 1120 bytes, then the AEAD ciphertext of the sealed map.
  ? "at_rest_sha256": hash-digest,          ; The content's at-rest digest. (on the content axis)
  ? "owner": identity-ref,                  ; The owner of the content or the stream. (on the content and stream axes)
  ? "community": group-ref,                 ; The community whose epoch key is wrapped. (on the epoch axis)
  ? "minter": identity-ref,                 ; The epoch's minter. (on the epoch axis)
  ? "epoch": uint,                          ; The epoch index. (on the epoch and stream axes)
  ? "stream_id": tstr,                      ; The stream. (on the stream axis)
  "asserted_at": ms-time,                   ; POSIX milliseconds.
  * tstr => ceg-value,
}

; delivery_ack:{stream_id}: authored by the subscriber; author, iss and sub are the subscriber.
delivery-ack = {
  "author": identity-ref,                   ; The subscriber, equal to iss and the CWT sub.
  "dimension": tstr,                        ; delivery_ack:{stream_id} with its version.
  "stream_id": tstr,                        ; The same stream as the leaf.
  "epoch": uint,                            ; The key-rotation index.
  "k": uint,                                ; The chunk index acknowledged.
  "chunk_root": hash-digest,                ; The published tree root the subscriber signs over.
  "asserted_at": ms-time,                   ; POSIX milliseconds.
  * tstr => ceg-value,
}

; identity:occurrence (CC 3.3.6): authored by a live roster key of the identity; the occurrence key's own statement is the second voice. Its binding members (the X-Wing keys, the opt-out) are those of transport-destination-binding.
identity-occurrence = {
  "author": identity-ref,                   ; A live roster key's identity: the identity named by identity_key_id.
  "identity_key_id": identity-ref,          ; The identity the occurrence speaks for: a person's, or an agent's own; on a row that seats a further room key, the voice.
  "occurrence_key_id": identity-ref,        ; The participant's key, equal to the CWT sub; its own statement over the payload is the second voice.
  "device_class": "phone" / "laptop" / "server" / "embedded" / "agent" / "service", ; A closed set; agent stands only under an agent's own identity.
  ? "hardware_attestation": bstr,           ; The attestation blob, as bytes. (where the occurrence carries one)
  ? "transport_destination": transport-destination, ; The RNS members of the binding's table. (where the occurrence binds an address)
  ? "encryption_pubkeys": encryption-pubkeys, ; The content-KEM keys. (where the occurrence is a wrap target)
  ? "room_binding_xwing_pubkey": bstr .size 1216, ; The identity's binding key on this device: an X-Wing public key, the ML-KEM-768 key of 1184 bytes then the X25519 key of 32 bytes. Neither half repeats a half of another KEM key on the row. (where the identity makes bindings in private rooms)
  ? "build_manifest_hash": hash-digest,     ; The hash of the pipeline-signed manifest. (where the occurrence names its build)
  ? "dial_hints": [1*8 [uint .le 255, bstr .size (0..255)]], ; An ordered sequence, most preferred first, of at most eight hints. Each is a type and a body, the body byte for byte that of the node code (CC 2.6.8). Never empty: absence is its one encoding. (where the occurrence gives places to dial; on a serve seat's binding in a genesis bundle)
  "refs": self-roster-refs,                 ; The self-roster head the signer stood on; a merge's further tips; and the rows the occurrence cites.
  "asserted_at": ms-time,                   ; POSIX milliseconds.
  ? "valid_until": ms-time,                 ; Later than asserted_at (CC 2.6.2). (where the occurrence states its own end)
  * tstr => ceg-value,
}

; The content-KEM keys of an occurrence (CC 3.3.6.1): a closed map.
encryption-pubkeys = {
  "x25519": bstr .size 32,                  ; A fresh content-KEM key, never the signing or the transport key.
  "ml_kem_768": bstr .size 1184,            ; The ML-KEM-768 public key.
}

; The refs of a self-roster row (CC 3.3.6.4): the head it stands on, required; a closed map.
self-roster-refs = {
  "head": row-ref,                          ; The last landed self-roster row the signer stood on, a bind or an eviction; the first bind names the genesis key's own record.
  ? "further_heads": row-ref-set,           ; The other tips the row merges, as a roster version names them: a set. (where the row merges tips)
  ? "target": row-ref,                      ; The occurrence this one supersedes. (on a supersession)
  ? "also": { + also-role => row-ref-set }, ; The build manifest's provenance row, and a seat's key record, under the role cites. (where the row names another row)
}

; identity_amendment (CC 3.1.5): authored by the agent's occurrence key; sub is the agent's identity.
identity-amendment = {
  "author": identity-ref,                   ; The agent's occurrence key's identity.
  "amendment_digest": hash-digest,          ; The SHA-256 of the applied amendment; it equals the approving response's.
  "refs": refs,                             ; The approving deferral:response:approved row, under the also role cites; the amendment it follows in refs.prev, absent on the base template (CC 2.7.11).
  "asserted_at": ms-time,                   ; POSIX milliseconds.
  * tstr => ceg-value,
}

; admission:unit (CC 2.7.11, CC 3.1.3): authored by one person, or counted over refs.head with no author; one person's row naming an effect admits only on that person's own host; sub is the unit's digest as canonical:sha256:{hex}.
admission-unit = {
  ? "author": identity-ref,                 ; The one person who admits; absent on a counted row, whose voices are its statements. Naming an effect, it admits only on the author's own host. (where the row is one person's)
  "unit": hash-digest,                      ; SHA-256 over the unit's bytes as the host loads them, or over its manifest; equals the CWT sub's digest.
  "capabilities": [+ capability],           ; A set from the closed seven; the last five are effects.
  ? "refs": refs,                           ; The roster head the count is over, in refs.head. (where the row is counted)
  "asserted_at": ms-time,                   ; The lease opens.
  "valid_until": ms-time,                   ; The lease closes: later than asserted_at, by at most unit_lease_max_secs.
  * tstr => ceg-value,
}
; The capabilities of CC 2.7.11: a closed set; the last five are effects.
capability = "compute" / "read" / "net_send" / "submit" / "sign" / "store_write" / "actuate"

; deferral:response:{outcome} (CC 3.1.9.3, CC 4.3): the members this form names; the response's further members are the store's.
deferral-response = {
  "author": identity-ref,                   ; The seated Wise Authority who answers.
  "dimension": tstr,                        ; deferral:response:approved:v1 or deferral:response:rejected:v1.
  ? "amendment_digest": hash-digest,        ; The digest of the amendment approved. (on an approval that authorises an identity amendment)
  "deferral_id": tstr,                      ; The request's own correlation id, copied from it.
  ? "call_fingerprint": hash-digest,        ; The fingerprint of the call approved; a dispatch resting on it executes only that call. (on an approval of a call)
  "refs": refs,                             ; The request answered, under answers.
  "asserted_at": ms-time,                   ; POSIX milliseconds.
  * tstr => ceg-value,
}

; deferral:request (CC 3.1.9.3, CC 4.3): authored by the deferring party; the request's further members are the store's.
deferral-request = {
  "author": identity-ref,                   ; The deferring party: an agent's occurrence key, or a person's own key.
  "deferral_id": tstr,                      ; The deferring party's own correlation id.
  "reason_digest": hash-digest,             ; The SHA-256 of the reason, which travels as bytes beside the row; a response carries none.
  ? "refs": refs,                           ; The request it was handed, under answers. (where the request sends a handed case up)
  "asserted_at": ms-time,                   ; POSIX milliseconds.
  "valid_until": ms-time,                   ; The request's own end, after which it re-routes.
  * tstr => ceg-value,
}

; transport:canonical_rebind (CC 3.1.3, CC 3.3.6.2): counted by a strict majority of the holders of the bundle in force; sub is the seated node.
canonical-rebind = {
  "refs": refs,                             ; The bundle in force the re-bind is counted over, in refs.head.
  "transport_destination": transport-destination, ; The seated node's new destination.
  "transit_xwing_pubkey": bstr .size 1216,  ; The seat's new transit key.
  ? "onion_hop_xwing_pubkey": bstr .size 1216, ; The seat's new onion hop key. (on a serve node)
  "asserted_at": ms-time,                   ; POSIX milliseconds.
  * tstr => ceg-value,
}

; trust:accepts (CC 3.2 T3, CC 4.4.3.34, CC 2.7.11): the owner's edge, signed by any live key of the owner's roster; a node's own edge is read only while its owner has signed none. sub is what the edge accepts: a lineage's name where it attaches a root, a Transparency Service's key thumbprint or identity, or on the admission walk an author's identity or a group's id. The edge names no refs.head and carries no scope. The members this form names; its further members are the store's.
trust-accepts = {
  "author": identity-ref,                   ; The owner whose edge it is: a person, and any live key of their roster signs it. A node's own edge is read only while its owner has signed none.
  "dimension": tstr,                        ; trust:accepts:v1. The CWT sub is what the edge accepts: a lineage's name, a service's key thumbprint or identity, an author's identity or a group's id. The edge names no refs.head and carries no scope.
  ? "attached_head_digest": hash-digest,    ; The object id of the bundle in force that the edge attaches on (CC 3.2 T4a). The member is what makes the edge one that attaches a root. A reader that holds a lineage of the name in sub refuses a new edge without it, trust_root_head_unnamed. (on an edge that attaches a root)
  ? "trust_classes": [+ tstr],              ; A set of class ids; absent, every class the charter declares. (where the edge narrows its classes)
  ? "trust_depth": 0..5,                    ; Absent reads 0. (where the edge reaches further)
  ? "service_key": { 1: int, 3: int, * int => any } / identity-ref, ; The Transparency Service's key: a COSE key with its kty and alg, or an identity reference whose key is its key:record. (on an edge of the class transparency)
  "asserted_at": ms-time,                   ; POSIX milliseconds.
  * tstr => ceg-value,
}

; provenance:build_manifest:{target} (CC 3.1.2.1): authored by the pipeline's key; one claim, type scores; the manifest blob is unsigned and cited by its digest.
build-manifest-row = {
  "author": identity-ref,                   ; The pipeline's key, equal to iss.
  "dimension": tstr,                        ; provenance:build_manifest:{target} with its version.
  "build": build-descriptor,                ; The descriptor of the manifest blob the row cites.
  "evidence_refs": [+ hash-digest],         ; The manifest blob, by its digest: the digest of build.manifest_hash is among them.
  "refs": refs,                             ; The bundle in force when the row is signed, in refs.head: the one the pipeline's grant names or a later bundle of the same lineage.
  "asserted_at": ms-time,                   ; POSIX milliseconds: the signed instant of the manifest, which the blob does not state.
  * tstr => ceg-value,
}

; The descriptor of a manifest blob (CC 3.1.2.1, CC 5.3.2.11): a closed map of exactly four members.
build-descriptor = {
  "project": tstr,                          ; The project, equal to the blob's project and listed by the pipeline's grant.
  "version": tstr,                          ; The version, equal to the blob's version.
  "manifest_hash": hash-digest,             ; The digest of the manifest blob.
  "manifest_size": uint .ge 1,              ; The blob's length in bytes, checked before the digest.
}

; trust:confers (CC 3.1.2.1, CC 4.2.1): a delegates_to row counted over the holders of the bundle in force, with no author; sub is the key the grant names.
trust-confers = {
  "dimension": tstr,                        ; trust:confers:v1.
  "scope": [+ tstr],                        ; A set of scope tokens; a pipeline's holds infra:attest:provenance:build_manifest or infra:attest and no other.
  ? "projects": [+ tstr],                   ; A set of project names; absent, the grant confers a build manifest for no project. (on a build pipeline's grant)
  "refs": refs,                             ; The bundle in force the grant is counted over, in refs.head.
  "asserted_at": ms-time,                   ; POSIX milliseconds.
  * tstr => ceg-value,
}

; The withdraws row that ends a grant (CC 4.2.1, CC 2.4.1.1): counted over the holders of the bundle in force, with no author.
grant-withdrawal = {
  "refs": refs,                             ; The grant withdrawn, under target; the head the withdrawal acts from, under head.
  ? "lifts": true,                          ; Present only as true. (where the count lifts single receipts)
  "asserted_at": ms-time,                   ; POSIX milliseconds.
  * tstr => ceg-value,
}

; act:ack (CC 3.1.3, CC 2.7.5): a receipt, type scores; one voice's, or a body's count with no author. It names 1 to 256 acts under refs.also ack, and no head.
act-ack = {
  ? "author": identity-ref,                 ; The one voice that acknowledges; a body's receipt is counted and carries none. (unless a body's count receipts)
  "dimension": tstr,                        ; act:ack:v1; the row's type is scores.
  "refs": refs,                             ; The acts acknowledged, under the also role ack: 1 to 256 of them. A receipt names no head; one that names more than 256 acts is refused, ack_names_too_many.
  "asserted_at": ms-time,                   ; POSIX milliseconds.
  * tstr => ceg-value,
}

; objection:{state}, the states assent and raised (CC 3.1.9.2, CC 3.3.6.4): authored by the voter; it names in refs.answers the one proposal it answers or act it objects to.
objection-vote = {
  "author": identity-ref,                   ; The voter.
  "dimension": tstr,                        ; objection:assent:v1 or objection:raised:v1; the states are closed at these two.
  "cohort": tstr,                           ; The scope of the standing set the vote is cast in; self for the self-roster door.
  "cohort_key_id": tstr,                    ; The standing set the vote is cast in; for the self-roster door the fedID.
  ? "grounds": tstr,                        ; The voter's grounds. (where the vote states its grounds)
  "refs": refs,                             ; Exactly one row, under answers: the proposal answered or the act objected to. A vote that carries objects_to_attestation_id or dismisses_objection_id is refused.
  "asserted_at": ms-time,                   ; POSIX milliseconds.
  * tstr => ceg-value,
}

; ownership:{relation}:{target_kind}:{version} (CC 3.2): the owner-binding, a delegates_to row authored by the owner; sub is the key owned, whose own statement over the same payload is the first-binding cosign. Its placement is cohort_scope with the group member that scope asks; a key held for an organisation names its affiliation in on_behalf_of.
owner-binding = {
  "author": identity-ref,                   ; The owner: an adult person, and any live key of their roster signs. The CWT sub is the key owned, an identity reference; that key's own statement over the same payload is the first-binding cosign.
  "dimension": tstr,                        ; ownership:responsible_party:node:v1 or ownership:responsible_party:agent:v1; the row's type is delegates_to.
  "delegation_purpose": "owner_binding",    ; The one single-valued purpose; a row of this family with another purpose is refused.
  ? "scope": [+ tstr],                      ; A set of scope tokens: a node's binding carries its infra tokens. Absent on an agent's binding, whose role is its template's (CC 2.7.11). (where the owner confers scopes)
  ? "delegation_valid_from": ms-time,       ; POSIX milliseconds; absent reads asserted_at. (where the binding states a start)
  ? "delegation_valid_until": ms-time,      ; POSIX milliseconds, later than the start; the binding lapses at this instant. (where the binding states its end)
  "cohort_scope": "self" / "family" / "community" / "affiliations" / "species" / "biosphere" / "federation", ; Where the row is placed: the scope its owner first places the node at, and a row re-signed at another scope stands beside it.
  ? "community_id": group-ref,              ; The group the row is placed in. It places the row and says nothing of who answers for the key. (iff cohort_scope is community or affiliations)
  ? "family_id": group-ref,                 ; The family the row is placed in. (iff cohort_scope is family)
  ? "on_behalf_of": group-ref,              ; The organisation's affiliation, which answers alongside the owner. One that names no affiliation is refused, owner_binding_not_an_affiliation. (where the owner holds the key for an organisation)
  ? "refs": refs,                           ; The affiliation's roster version, under head, and no other role; the affiliation's voices are further statements counted at that head. (iff the row carries on_behalf_of)
  "asserted_at": ms-time,                   ; POSIX milliseconds.
  * tstr => ceg-value,
}

; holon:claim (CC 3.1.11): authored by the signer under its own name; one claim, type scores; sub is the holon's id as text. The declaration is an unsigned blob cited by its digest, which is among evidence_refs. In refs it names only rows of its own group: those it follows, under prev and further_prev, and on a supersedes the row it replaces, under target; no head.
holon-claim = {
  "author": identity-ref,                   ; The signer, under its own name. The CWT sub is the holon's id as text.
  "dimension": tstr,                        ; holon:claim:v1; the row's type is scores.
  "spec": tstr .size (1..128),              ; The declaration format whose checks were run, as ciris/holon-decl/0.
  "holon": tstr .size (1..128),             ; The holon's id: lower-case words joined by full stops, at most 128 bytes.
  "view": tstr .size (1..128),              ; The view's id, in the form of the holon's id.
  "consumer": tstr .size (1..128),          ; The consumer's id, in the form of the holon's id.
  "kind": tstr .size (1..64),               ; A token of the declaration's vocabulary, read from the blob; this document closes no set of kinds.
  "declaration": hash-digest,               ; The SHA-256 digest of the declaration blob's stored bytes; it is among evidence_refs.
  "evidence_refs": [+ hash-digest],         ; The declaration and every file the claim cites, each by its digest: a sequence.
  "score": fixed6-score,                    ; +10^6 where the signer says the checks held; -10^6 where the signer ran them and they did not hold; no other value.
  ? "confidence": fixed6-unit,              ; fixed6 in [0, 10^6]. (where the signer states a confidence)
  ? "body": holon-claim-body,               ; The bound the claim states; a claim of exact agreement carries no bound. (where the claim states a bound)
  ? "refs": refs,                           ; The row it follows, under prev, and further heads of the same group under further_prev; on a supersedes, a recants or a withdraws, the row acted on under target. No head and no other role. (where the row follows an earlier row of its signer for the same claim)
  "asserted_at": ms-time,                   ; POSIX milliseconds.
  * tstr => ceg-value,
}

; The body of a holon:claim that states a bound (CC 3.1.11); a claim of exact agreement carries no body.
holon-claim-body = {
  "bound": body-decimal,                    ; The bound, a decimal fraction (tag 4); it MAY be negative.
  ? "realised": body-decimal,               ; The value realised, a decimal fraction (tag 4). (iff basis is realised)
  "unit": tstr .size (1..64),               ; The bound's unit: a token of the declaration's vocabulary, read from the blob.
  "basis": "price" / "realised",            ; What the bound is stated on.
  * tstr => ceg-value,
}
