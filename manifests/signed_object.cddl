; CC 2.6.1.7 — the signed object. GENERATED by tools/build_cc_signed_object.py from
; constitution/signed_object.tsv; do not edit. RFC 8610 CDDL, JSON profile (Appendix E).
; Typed from CIRISPersist ee30310f src/federation/envelope.rs.
; The signing input is JCS(attestation-row.attestation_envelope), RFC 8785, and nothing else.

attestation-row = {
  attestation_id: uuid,  ; REQUIRED
  attesting_key_id: key-id,  ; REQUIRED
  attested_key_id: key-id,  ; REQUIRED
  attestation_type: row-type,  ; REQUIRED
  ? weight: number,  ; OPTIONAL; default absent
  asserted_at: rfc3339,  ; REQUIRED
  ? expires_at: rfc3339,  ; OPTIONAL; default absent
  ? subject_key_ids: [* subject-id],  ; OPTIONAL (absent when empty); default absent; array kind: set
  cohort_scope: cohort-scope,  ; REQUIRED
  attestation_envelope: envelope,  ; REQUIRED
  original_content_hash: hex64,  ; REQUIRED
  ? additional_scrubs: [* scrub-sig],  ; OPTIONAL (absent when empty); default absent; array kind: sequence
  ? persist_row_hash: hex64,  ; OPTIONAL (store-computed; absent on a row as emitted)
  scrub_signature_classical: base64,  ; REQUIRED
  ? scrub_signature_pqc: base64,  ; REQUIRED at the federation tier
  scrub_key_id: key-id,  ; REQUIRED
  scrub_timestamp: rfc3339,  ; REQUIRED
  ? pqc_completed_at: rfc3339,  ; OPTIONAL
  ; persist-internal members (tier, promoted_at, withdraws_admission_rule) are not part of this contract
}

; The signed object. Member presence is exactly what the producer signed (CC 2.6.1.1):
; an absent optional member is absent, never materialised; unknown members are preserved (CC 2.1.1).
envelope = {
  row: row-mirror,  ; REQUIRED; the closed mirror of the seven columns beside the row
  asserted_at: rfc3339-ms,  ; REQUIRED; default stamped at the mint
  ? expires_at: rfc3339-ms,  ; OPTIONAL; default absent (no expiry)
  dimension: tstr,  ; REQUIRED on every row type
  ? references_attestation_id: uuid,  ; REQUIRED on supersedes, withdraws, recants
  ? scope: tstr / [* tstr],  ; REQUIRED on consent:state:granted and on delegates_to; array kind: set
  ? pre_rotation_commitment: hex64,  ; OPTIONAL (charter); default absent
  ? recovers: key-id,  ; REQUIRED on a charter recovery; default absent
  ? successor_keys: [* key-id],  ; REQUIRED on a charter recovery; default absent; array kind: set
  ? withdrawal_reason: tstr,  ; OPTIONAL on withdraws; default absent
  ? consent_supersedes: uuid,  ; OPTIONAL on consent:state:*; default absent
  ? delivery_mode: "pull" / "push",  ; OPTIONAL; default pull
  ? deletion_window: tstr,  ; OPTIONAL; default absent
  ? media: { * tstr => any },  ; OPTIONAL; default absent
  ? widened_at: rfc3339-ms,  ; REQUIRED on a widening supersedes, absent otherwise; default absent
  ? accord_root: key-id,  ; REQUIRED on accord:* rows; default absent
  ? attach_window_secs: uint,  ; OPTIONAL on trust:charter:v1; default absent (anchor only)
  ? witness_cadence_secs: uint,  ; REQUIRED on a witnessed lineage's charter; default absent
  ? witness_quorum: uint,  ; REQUIRED on a witnessed lineage's charter; default absent (= 0, witnessed mode off)
  ? attached_head_digest: hex64,  ; REQUIRED on trust:accepts:v1
  ? recovery_commitments: { * key-id => hex64 },  ; REQUIRED on the accord's charter
  ? score: number,  ; REQUIRED on scores
  ? confidence: number,  ; REQUIRED on scores
  ? context: tstr,  ; OPTIONAL; default absent
  ? evidence_refs: [* tstr],  ; OPTIONAL (some families require it); default absent; array kind: sequence
  ? valid_until: rfc3339-ms,  ; OPTIONAL; default absent
  ? epistemic_mode: "direct" / "crypto" / "hearsay" / "derivative" / "appeal",  ; OPTIONAL; default direct
  ? witness_relation: "self" / "external" / "derived",  ; OPTIONAL; default external
  ? oversight_mode: "HITL" / "HOTL" / "HOOTL",  ; OPTIONAL; default absent (per-cell default)
  ? occurrence_id: tstr,  ; OPTIONAL; default absent (read as occurrence-0)
  ? occurrence_count: uint,  ; OPTIONAL; default absent (read as 1)
  ? occurrence_role: "primary" / "shared" / "replica",  ; OPTIONAL; default absent (read as primary)
  ? stake: "free" / "reputational" / "capital" / "cryptoeconomic",  ; OPTIONAL; default reputational
  ? community_id: key-id,  ; REQUIRED iff cohort_scope is community or affiliations
  ? family_id: key-id,  ; REQUIRED iff cohort_scope is family
  ? session_id: tstr,  ; REQUIRED on session:*
  ? claimed_at: rfc3339-ms,  ; REQUIRED on session:*
  ? custody_state: "here" / "none",  ; REQUIRED on custody:ack
  ? group_kind: "family" / "community",  ; REQUIRED on membership:proposal
  ? role: tstr,  ; OPTIONAL on membership:proposal, restated on membership:acceptance; default absent
  ? proposal_hash: hex64,  ; REQUIRED on membership:acceptance and membership:decline
  ? subject_sha256_ed25519_raw: hex64,  ; OPTIONAL on moderation:*; default absent
  ? halt_fuse_secs: uint,  ; OPTIONAL on the accord's charter; default 86400 (a constant of this document)
  ? witnesses: [* key-record],  ; REQUIRED on a witnessed lineage's charter; array kind: set
  ? history_on_join: "full" / "from_join",  ; OPTIONAL; default from_join
  ? supersession_reason: tstr,  ; OPTIONAL on supersedes; default absent
  ? differs_in: [* tstr],  ; OPTIONAL on supersedes; a widening lists cohort_scope; default absent; array kind: set
  ? recantation_reason: tstr,  ; OPTIONAL on recants; default absent
  ? what_was_false: tstr,  ; OPTIONAL on recants; default absent
  ? delegation_purpose: tstr,  ; OPTIONAL on delegates_to; default absent
  ? delegation_valid_from: rfc3339-ms,  ; OPTIONAL on delegates_to; default the edge's asserted_at
  ? delegation_valid_until: rfc3339-ms,  ; REQUIRED on a termed delegates_to (CC 2.4.1), otherwise OPTIONAL; default absent (open-ended)
  ? consent_basis: [* consent-basis],  ; OPTIONAL (capacity:*, observation:access_assumption:v1); default absent; array kind: sequence
  ? n_eff_pr: number,  ; OPTIONAL (carried on capacity:*; validated at the capacity:* gate); default absent
  ? n_eff_h: number,  ; OPTIONAL (carried on capacity:*; validated at the capacity:* gate); default absent
  ? sample_size: uint,  ; OPTIONAL (carried on capacity:*; validated at the capacity:* gate); default absent
  ? feature_dim: uint,  ; OPTIONAL (carried on capacity:*; validated at the capacity:* gate); default absent
  ? sample_size_gate: uint,  ; OPTIONAL (carried on capacity:*; validated at the capacity:* gate); default absent
  ? target_n_eff: number,  ; OPTIONAL (carried on capacity:*; validated at the capacity:* gate); default absent
  ? min_feature_dim: uint,  ; OPTIONAL (carried on capacity:*; validated at the capacity:* gate); default absent
  ? n_eff_floor: number,  ; OPTIONAL (carried on capacity:*; validated at the capacity:* gate); default absent
  ? window: uint,  ; OPTIONAL (capacity:*, observation:access_assumption:v1); default absent
  ? trace_level: "generic" / "detailed" / "full_traces",  ; REQUIRED on observation:access_assumption:v1; default absent
  ? occurrence_key_ids: [* key-id],  ; REQUIRED on observation:access_assumption:v1; default absent; array kind: set
  ? window_from: rfc3339-ms,  ; REQUIRED on observation:access_assumption:v1; default absent
  ? window_to: rfc3339-ms,  ; REQUIRED on observation:access_assumption:v1; default absent
  ? channel_classes: [* tstr],  ; REQUIRED on observation:access_assumption:v1; default absent; array kind: set
  ? amendment_digest: hex64,  ; REQUIRED on identity_amendment:v1; default absent
  ? authorized_by: uuid,  ; REQUIRED on identity_amendment:v1; default absent
  ? for_key_id: key-id,  ; REQUIRED on census:share:{class}:v1, census:member:share:v1; default absent
  ? period: uint,  ; REQUIRED on census:share:{class}:v1, census:member:share:v1, census:partial:{class}:v1, census:member:partial:v1, census:composite:{class}:v1, ballot:tally:{poll_id}:v1, census:expected_active:v1; default absent
  ? return_token: hex64,  ; REQUIRED on census:share:{class}:v1, census:member:share:v1; default absent
  ? share_index: uint,  ; REQUIRED on census:share:{class}:v1, census:member:share:v1, census:partial:{class}:v1, census:member:partial:v1; default absent
  ? share_count: uint,  ; REQUIRED on census:partial:{class}:v1, census:member:partial:v1; default absent
  ? source_count: uint,  ; REQUIRED on census:composite:{class}:v1, ballot:tally:{poll_id}:v1; default absent
  ? n_eff: uint,  ; REQUIRED on census:composite:{class}:v1, ballot:tally:{poll_id}:v1; default absent
  ? max_source_multiplicity: uint,  ; REQUIRED on census:composite:{class}:v1, ballot:tally:{poll_id}:v1; default absent
  ? mass_commitment_hex: hex64,  ; REQUIRED on census:composite:{class}:v1, ballot:tally:{poll_id}:v1; default absent
  ? member_commitment_hex: hex64,  ; REQUIRED on census:partial:{class}:v1, census:member:partial:v1, census:composite:{class}:v1, ballot:tally:{poll_id}:v1, census:expected_active:v1; default absent
  ? mass_total: tstr,  ; REQUIRED on census:partial:{class}:v1, census:member:partial:v1, census:composite:{class}:v1, ballot:tally:{poll_id}:v1; default absent
  ? aggregation_algorithm_id: tstr,  ; REQUIRED on census:partial:{class}:v1, census:member:partial:v1, census:composite:{class}:v1, ballot:tally:{poll_id}:v1; default absent
  ? noise_floor_descriptor: tstr,  ; OPTIONAL on census:composite:{class}:v1, ballot:tally:{poll_id}:v1; default absent
  ? version: uint,  ; REQUIRED on census:composite:{class}:v1, ballot:tally:{poll_id}:v1; default absent
  ? partial_a: uuid,  ; REQUIRED on census:composite:{class}:v1, ballot:tally:{poll_id}:v1; default absent
  ? partial_b: uuid,  ; REQUIRED on census:composite:{class}:v1, ballot:tally:{poll_id}:v1; default absent
  ? window_periods: uint,  ; REQUIRED on census:expected_active:v1; default absent
  ? active_count: uint,  ; REQUIRED on census:expected_active:v1; default absent
  ? floor_applied: bool,  ; REQUIRED on census:expected_active:v1; default absent
  * tstr => any,  ; family payload members (CC 3.3) and anything a consumer has not learned yet
}

; Closed: exactly these seven members. deny_unknown_fields.
row-mirror = {
  attestation_id: uuid,  ; REQUIRED
  attesting_key_id: key-id,  ; REQUIRED
  attestation_type: row-type,  ; REQUIRED
  attested_key_id: key-id,  ; REQUIRED; default the attester
  subject_key_ids: [* subject-id],  ; REQUIRED (may be empty); default []; array kind: set
  cohort_scope: cohort-scope,  ; REQUIRED
  ? weight: number,  ; OPTIONAL; default absent
}

scrub-sig = {
  scrub_key_id: key-id,  ; REQUIRED
  scrub_signature_classical: base64,  ; REQUIRED
  ? scrub_signature_pqc: base64,  ; REQUIRED at the federation tier
  ? cosigned_at: rfc3339-ms,  ; OPTIONAL; default absent
}

key-record = {
  key_id: key-id,  ; REQUIRED
  pubkey_ed25519_base64: base64,  ; REQUIRED
  ? pubkey_ml_dsa_65_base64: base64,  ; REQUIRED for algorithm hybrid
  algorithm: tstr,  ; REQUIRED
  identity_type: tstr,  ; REQUIRED
  identity_ref: tstr,  ; REQUIRED
  valid_from: rfc3339,  ; REQUIRED
  ? valid_until: rfc3339,  ; OPTIONAL; default absent
  registration_envelope: { * tstr => any },  ; REQUIRED
  original_content_hash: hex64,  ; REQUIRED
  scrub_signature_classical: base64,  ; REQUIRED
  ? scrub_signature_pqc: base64,  ; REQUIRED once hybrid-complete
  scrub_key_id: key-id,  ; REQUIRED
  scrub_timestamp: rfc3339,  ; REQUIRED
  ? pqc_completed_at: rfc3339,  ; OPTIONAL
  persist_row_hash: hex64,  ; REQUIRED
  ? roles: [* tstr],  ; OPTIONAL; default []; array kind: set
  ? attestation_evidence: { * tstr => any },  ; OPTIONAL; default absent
  ? additional_scrubs: [* scrub-sig],  ; OPTIONAL (absent when empty); default absent; array kind: sequence
}

; CC 2.1 consent_basis entry.
consent-basis = { principal: key-id, paths: [* ("subject" / "occurrence_of" / "delegates_to")], attestation_id: uuid }

row-type = "scores" / "delegates_to" / "supersedes" / "withdraws" / "recants"
cohort-scope = "self" / "family" / "community" / "affiliations" / "species" / "biosphere" / "federation"
uuid = tstr .regexp "[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}"
key-id = tstr .regexp "[a-z0-9-]+"  ; <label>-<fingerprint>, CC 2.6.8; a legacy 64-hex id is also a key-id
canonical-id = tstr .regexp "canonical:[a-z0-9-]+:[0-9a-f]+"  ; CC 2.3.2.1, tag required
subject-id = key-id / canonical-id
hex64 = tstr .regexp "[0-9a-f]{64}"  ; CC 2.6.3
base64 = tstr .regexp "[A-Za-z0-9+/]+={0,2}"  ; RFC 4648 section 4, padded, no whitespace
rfc3339-ms = tstr .regexp "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z"  ; CC 2.6.2
rfc3339 = tstr  ; a column rendered by the store; the signed twin inside the envelope is rfc3339-ms

